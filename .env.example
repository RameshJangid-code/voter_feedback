# Shri Mohan Singh Ji - Budivada Sarpanch Public Feedback Portal
# Environment Configuration

# -------------------------------------------------------------
# Firebase Client Configuration (Cloud Firestore & Firebase Auth)
# Obtain these from your Firebase Console -> Project Settings -> General -> Your Apps -> Web App
# -------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=budivada-sarpanch.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=budivada-sarpanch
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=budivada-sarpanch.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# -------------------------------------------------------------
# Admin Secret & Server Settings
# -------------------------------------------------------------
ADMIN_SECRET_KEY=super-secure-random-key-for-budivada-admin-2026

# Server-side data store used by API routes. Set to a real MongoDB deployment.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DB=budivada_sarpanch

# Firebase Admin credentials for verifying authenticated admin API requests.
# Set a service-account JSON secret here, or configure Google Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=budivada-sarpanch

# Note:
# When these Firebase credentials are not populated or in initial local development,
# the application automatically activates its built-in resilient local storage engine
# with pre-seeded demo records for evaluation!
# To access the admin panel locally right away, use:
# Email: admin@budivada.in
# Password: budivada2026
